/* index.css */

*{
	margin: 0;
	padding: 0;
	box-sizing: border-box;

	font-size: 16px	
}

body{
	margin: 1rem;
	background: black;
	color: white;
}

a{
	color: inherit;
	text-decoration: none;
}

header{
display: flex;
justify-content: space-between;
}

main{
	text-align: center;
}

main h1{
font-size: 3.5rem; /*16px * 2 = 32px
     16px * 3 = 48px
     16px * 3.5 = 56px*/
}

main h3{
font-size: 1.8rem; 
color:#86868b;
}
